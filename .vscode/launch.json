    "version": "0.2.0",
    "configurations": [
        {
            "name": "tsx",
            "type": "node",
            "request": "launch",
            "program": "${workspaceRoot}/src/index.ts",
            "runtimeExecutable": "tsx",
            "console": "internalConsole",
            "skipFiles": [
                // Node.js internal core modules
                "<node_internals>/**",
                // Ignore all dependencies (optional)
                "${workspaceFolder}/node_modules/**",
            ],
            "preLaunchTask": "tsc: build"
        }
    ]
}