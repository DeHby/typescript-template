{
    "name": "typescript_template",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=16"
    },
    "scripts": {
        "release": "yarn --production",
        "watch": "tsx watch --clear-screen=false ./src/index.ts",
        "build": "yarn clean & tsc",
        "dev": "yarn clean & tsc -w -preserveWatchOutput",
        "type-check": "tsc --noEmit",
        "start": "tsx ./dist/index.js",
        "upgrade": "yarn upgrade-interactive --latest",
        "clean": "if exist dist (rmdir /s /q dist)"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "tsx": "^4.19.2",
        "typescript": "^5.2.2"
    },
    "devDependencies": {
        "@types/dotenv": "^8.2.0",
        "@types/node": "^22.10.5"
    }
}