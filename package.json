{
    "name": "typescript_template",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "type": "commonjs",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "release": "yarn --production",
        "watch": "tsc -w",
        "build:watch": "concurrently \"tsc -w\" \"tsc-alias -w\" --raw",
        "rebuild": "yarn clean && yarn && build",
        "build": "tsc && tsc-alias",
        "start": "node -r dotenv/config ./dist/index",
        "upgrade": "yarn upgrade-interactive --latest",
        "clean": "if exist dist (rmdir /s /q dist)",
        "dev": " tsc-watch --onSuccess \"yarn dev-command\""
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "typescript": "^5.2.2"
    },
    "devDependencies": {
        "@types/dotenv": "^8.2.0",
        "@types/node": "^22.10.5",
        "concurrently": "^9.1.2",
        "tsc-alias": "^1.8.10",
        "tsc-watch": "^6.2.1"
    }
}
