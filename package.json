{
    "name": "typescript_template",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "type": "commonjs",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "release": "yarn --production",
        "rebuild": "yarn clean && yarn build",
        "build": "tsc && tsc-alias",
        "start": "node --enable-source-maps -r dotenv/config ./dist/index",
        "upgrade": "yarn upgrade-interactive --latest",
        "clean": "node --eval \"import('node:fs').then(fs=>{fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('node_modules/.cache/tsbuildinfo',{force:true})})\"",
        "dev": "tsx watch -r dotenv/config src/index.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "dotenv": "^17.4.2"
    },
    "devDependencies": {
        "@types/node": "^26.0.0",
        "prettier": "^3.5.1",
        "tsc-alias": "^1.8.10",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
